<?xml version="1.0" encoding="utf-8"?>
<!--
    API 30 이하의 자동 백업 규칙. allowBackup="false" 로 백업 자체를 끄지만,
    토큰·세션 저장 파일은 규칙에서도 한 번 더 제외한다.
-->
<full-backup-content>
    <exclude
        domain="file"
        path="datastore/auth_tokens.preferences_pb" />
    <exclude
        domain="file"
        path="datastore/session_journal.preferences_pb" />
</full-backup-content>
