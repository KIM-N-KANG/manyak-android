# local.properties 에 채울 항목. 이 파일을 복사해 쓰고, 값이 든 local.properties 는 커밋하지 않는다.
#
#   cp local.properties.example local.properties
#
# sdk.dir 은 Android Studio 가 자동으로 채운다.

# --- 서버 주소 -------------------------------------------------------------
# debug 빌드는 비워 두면 dev 서버(https://dev-api.manyak.app/api/v1/)를 쓴다.
# 로컬 서버에 붙일 때만 채운다. 끝에 슬래시가 있어야 Retrofit 이 경로를 이어 붙인다.
# BASE_URL=http://10.0.2.2:8080/api/v1/

# 약관·개인정보처리방침을 여는 웹 주소. 비워 두면 운영 웹(https://manyak.app)을 연다.
# WEB_BASE_URL=https://manyak.app

# --- 소셜 로그인 제공자 키 --------------------------------------------------
# 값은 Google Cloud Console·카카오 개발자 콘솔에서 받는다. **레포에 커밋하지 않는다.**
# 없으면 빌드는 되지만 해당 제공자 로그인이 시작 단계에서 실패한다.
#
# 구글: 서버(웹) 클라이언트 ID. Android 클라이언트 ID 가 아니다 — ID 토큰의 aud 에 들어가는 값이다.
# 카카오: 네이티브 앱 키. REST API 키가 아니다.
GOOGLE_SERVER_CLIENT_ID_DEBUG=
KAKAO_NATIVE_APP_KEY_DEBUG=

# 릴리스 값은 스토어 앱 서명 키 지문을 콘솔에 등록한 뒤 채운다. CI 에서는 시크릿으로 주입한다.
GOOGLE_SERVER_CLIENT_ID_RELEASE=
KAKAO_NATIVE_APP_KEY_RELEASE=
