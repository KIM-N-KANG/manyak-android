<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ 의 백업·기기 이전 규칙. 토큰과 세션 종료 저널은 어느 경로로도 나가지 않는다.
    Keystore 키는 기기를 벗어나지 못하므로 옮겨진 파일은 어차피 복호화되지 않지만,
    파일 자체를 내보내지 않는 것이 계약이다(하네스 §3-3-4).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/auth_tokens.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/session_journal.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/auth_tokens.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/session_journal.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
