<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Meta SDK 가 광고 식별자로 설치를 광고에 귀속한다. Android 13 이상은 이 권한 없이는 ID 를 0 으로 받는다. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".ManyakApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ManyakAndroid">
        <!--
            Meta 앱 이벤트. 초기화와 설치, 실행 이벤트 전송은 SDK 가 자동으로 한다.
            앱 ID 는 "fb" 접두어가 있어야 한다. 숫자만 넣으면 aapt 가 정수로 읽어 값이 깨진다.
        -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="fb${metaAppId}" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="${metaClientToken}" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ManyakAndroid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                웹 앱 안내 배너의 앱 열기 링크(intent:// 에 패키지를 지정)를 받는다. https 대신 전용 스킴을 쓰는 이유는
                검증되지 않은 https 필터가 Android 11 이하에서 다른 앱의 manyak.app 링크마다 앱 선택창을 띄우기 때문이다.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="manyak.app"
                    android:scheme="manyak" />
            </intent-filter>
        </activity>

        <!--
            카카오계정 웹 로그인의 리다이렉트 수신부. 액티비티 자체는 카카오 SDK 매니페스트가 선언하고,
            여기서는 네이티브 앱 키에서 파생된 스킴의 intent-filter 만 얹는다. 실제 키를 아는 것이
            :app 뿐이라 이 선언도 여기 둔다 — 라이브러리 매니페스트의 placeholder 는 앱 병합 전에
            그 모듈의 값으로 치환되어 실제 키가 들어가지 않는다.

            MissingClass 억제 — 클래스는 :core:data 의 전이 의존인 카카오 SDK 에 있어 실행 시점에는
            APK 에 포함되지만, SDK 가 :app 의 컴파일 경로에는 없어 lint 가 확인하지 못한다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="kakao${kakaoNativeAppKey}" />
            </intent-filter>
        </activity>
    </application>

</manifest>